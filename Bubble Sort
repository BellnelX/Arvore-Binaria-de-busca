int main(void){
    srand((unsigned int) time(NULL));

    imprime_integrantes();

    int original[N_caracter];
    gera_vetor_unico(original, N_caracter);

    printf("Vetor original:\n");
    imprime_vetor(original, N_caracter);
    printf("\n");

    printf("Algoritmo de ordenação: Bubble Sort (Simples)\n\n");

    Contador ctr;
    int vordenado[N_caracter];
    memcpy(vordenado, original, sizeof(original));
    bubble_sort(vordenado, N_caracter, &ctr);

    printf("Vetor ordenado:\n");
    imprime_vetor(vordenado, N_caracter);
    printf("Total de comparações: %lu\n", ctr.comparacoes);
    printf("Total de trocas: %lu\n\n", ctr.trocas);

    NoArv *raiz = NULL;
    for(size_t i = 0; i < N_caracter; i++){
        raiz = InserirVersao1(raiz, original[i]);
    }

    printf("Percurso EM ORDEM:\n");
    percurso_em(raiz);
    printf("\n");

    printf("Percurso PRÉ ORDEM:\n");
    percurso_pre(raiz);
    printf("\n");

    printf("Percurso PÓS ORDEM:\n");
    percurso_pos(raiz);
    printf("\n");

    printf("\nAltura da árvore: %d\n", altura(raiz));

    libera_arvore(raiz);
    return 0;
}
