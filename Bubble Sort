#include <stdio.h>
#include <stdlib.h>
#include <time.h>
#include <string.h>

#define N_caracter 20
#define MAX_VAL 501

typedef struct NoArv {
    int chave;
    struct NoArv *esquerda;
    struct NoArv *direita;
} NoArv;

// Cria novo nó da árvore
NoArv* NovoNoArv(int chave){
    NoArv* n = (NoArv*) malloc(sizeof(NoArv));
    if(!n) return NULL;
    n->chave = chave;
    n->esquerda = n->direita = NULL;
    return n;
}

// Inserção na Árvore
NoArv* InserirVersao1(NoArv* raiz, int chave){
    if(!raiz) return NovoNoArv(chave);
    if(chave < raiz->chave)
        raiz->esquerda = InserirVersao1(raiz->esquerda, chave);
    else if(chave > raiz->chave)
        raiz->direita = InserirVersao1(raiz->direita, chave);
    return raiz;
}

// Percurso em ordem
void percurso_em(NoArv* raiz){
    if(!raiz) return;
    percurso_em(raiz->esquerda);
    printf("%d ", raiz->chave);
    percurso_em(raiz->direita);
}

// Percurso pré ordem
void percurso_pre(NoArv* raiz){
    if(!raiz) return;
    printf("%d ", raiz->chave);
    percurso_pre(raiz->esquerda);
    percurso_pre(raiz->direita);
}

// Percurso pós ordem
void percurso_pos(NoArv* raiz){
    if(!raiz) return;
    percurso_pos(raiz->esquerda);
    percurso_pos(raiz->direita);
    printf("%d ", raiz->chave);
}

// Calcula altura da árvore
int altura(NoArv* raiz){
    if(!raiz) return 0;
    int he = altura(raiz->esquerda);
    int hd = altura(raiz->direita);
    return (he > hd ? he : hd) + 1;
}

// Libera memória da árvore
void libera_arvore(NoArv* raiz){
    if(!raiz) return;
    libera_arvore(raiz->esquerda);
    libera_arvore(raiz->direita);
    free(raiz);
}

typedef struct {
    unsigned long comparacoes;
    unsigned long trocas;
} Contador;

// Imprime vetor
void imprime_vetor(const int *v, size_t n){
    for(size_t i = 0; i < n; i++){
        printf("%d", v[i]);
        if(i + 1 < n) printf(", ");
    }
    printf("\n");
}

// BUBBLE SORT SIMPLES
void bubble_sort(int *v, size_t n, Contador *ctr){
    ctr->comparacoes = 0;
    ctr->trocas = 0;

    for(size_t i = 0; i < n - 1; i++){
        for(size_t j = 0; j < n - 1 - i; j++){
            ctr->comparacoes++;
            if(v[j] > v[j + 1]){
                int temp = v[j];
                v[j] = v[j + 1];
                v[j + 1] = temp;
                ctr->trocas++;
            }
        }
    }
}

// Verifica se número já existe no vetor
int existe(const int *v, size_t size, int val){
    for(size_t i = 0; i < size; i++){
        if(v[i] == val) return 1;
    }
    return 0;
}

// Gera vetor sem números repetidos
void gera_vetor_unico(int *v, size_t n){
    size_t cont = 0;
    while(cont < n){
        int x = (rand() % MAX_VAL) + 1;
        if(!existe(v, cont, x))
            v[cont++] = x;
    }
}

